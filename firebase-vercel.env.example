# Firebase Web SDK configuration — public project settings, not service-account secrets.
# Replace values with the matching Firebase Console → Project settings → General values.
VITE_FIREBASE_API_KEY=REPLACE_WITH_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=REPLACE_WITH_FIREBASE_AUTH_DOMAIN
VITE_FIREBASE_DATABASE_URL=REPLACE_WITH_FIREBASE_DATABASE_URL
VITE_FIREBASE_PROJECT_ID=REPLACE_WITH_FIREBASE_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=REPLACE_WITH_FIREBASE_STORAGE_BUCKET
VITE_FIREBASE_MESSAGING_SENDER_ID=REPLACE_WITH_FIREBASE_MESSAGING_SENDER_ID
VITE_FIREBASE_APP_ID=REPLACE_WITH_FIREBASE_APP_ID
VITE_FIREBASE_MEASUREMENT_ID=REPLACE_WITH_FIREBASE_MEASUREMENT_ID

# Optional server fallbacks; these values are public configuration, not service-account credentials.
FIREBASE_DATABASE_URL=REPLACE_WITH_FIREBASE_DATABASE_URL
FIREBASE_PROJECT_ID=REPLACE_WITH_FIREBASE_PROJECT_ID

# Super Admin access is assigned by setting adminUids/<Firebase Auth UID> = true in RTDB Console.
