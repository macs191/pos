{
  "buildCommand": "pnpm build",
  "installCommand": "pnpm install --frozen-lockfile",
  "outputDirectory": "dist/public",
  "framework": null,
  "functions": {
    "api/index.ts": {
      "runtime": "nodejs22.x",
      "maxDuration": 60
    },
    "api/[...path].ts": {
      "runtime": "nodejs22.x",
      "maxDuration": 60
    },
    "api/trpc/[...path].ts": {
      "runtime": "nodejs22.x",
      "maxDuration": 60
    },
    "api/health.ts": {
      "runtime": "nodejs22.x",
      "maxDuration": 10
    }
  },
  "rewrites": [
    { "source": "/((?!api/|assets/|manifest.webmanifest|sw.js|favicon.ico).*)", "destination": "/index.html" }
  ]
}
